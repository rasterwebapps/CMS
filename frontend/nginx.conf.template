# ── Rate limiting ─────────────────────────────────────────────────────────────
limit_req_zone $binary_remote_addr zone=auth:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=api:10m  rate=30r/s;

# ── Dynamic port extraction from Host header ──────────────────────────────────
# Handles both dev.raster.in:212 and 172.17.1.243:8443 transparently.
map $http_host $forwarded_port {
    ~:(\d+)$  $1;
    default   443;
}

server {
    listen 80;

    # Keycloak JS requires Web Crypto, which browsers expose only in secure
    # contexts. Always move production traffic to HTTPS.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;

    ssl_certificate     /etc/nginx/ssl/self.crt;
    ssl_certificate_key /etc/nginx/ssl/self.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root  /usr/share/nginx/html;
    index index.html;

    # ── Security headers ──────────────────────────────────────────────────────
    add_header X-Content-Type-Options "nosniff"                        always;
    add_header X-Frame-Options        "SAMEORIGIN"                     always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy     "geolocation=(), microphone=(), camera=()" always;

    # ── Keycloak proxy ────────────────────────────────────────────────────────
    # IMPORTANT: X-Forwarded-Host is ALWAYS set to the canonical domain
    # (dev.raster.in:212) regardless of how the user accessed the app.
    # This ensures Keycloak always issues JWTs with the canonical issuer URI
    # that the Spring Boot backend is configured to trust.
    # The Keycloak JS redirect_uri is still browser-origin-based (handled by
    # the Angular app), so post-login redirects return to whichever URL the
    # user came from.
    location /realms/ {
        limit_req zone=auth burst=30 nodelay;
        proxy_pass http://${KEYCLOAK_UPSTREAM};
        proxy_set_header Host              dev.raster.in:212;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  dev.raster.in:212;
        proxy_set_header X-Forwarded-Port  212;
        proxy_buffer_size  128k;
        proxy_buffers      4 256k;
    }

    location /resources/ {
        limit_req zone=auth burst=30 nodelay;
        proxy_pass http://${KEYCLOAK_UPSTREAM};
        proxy_set_header Host              dev.raster.in:212;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port  212;
    }

    # ── Spring Boot API proxy ─────────────────────────────────────────────────
    location /api/ {
        limit_req zone=api burst=60 nodelay;
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── env.js — never cache (content changes per deployment/server) ──────────
    location = /assets/env.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma        "no-cache" always;
        expires 0;
    }

    # ── Angular SPA ───────────────────────────────────────────────────────────
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none';" always;
    }
}

# Copy this to /docker_data/skscms209/.env on 172.16.7.209 and chmod 600.
# Use strong production-only secrets. Do not reuse 243 credentials.

DEPLOY_HOST=cms.nursing.sksh.ac.in
PUBLIC_IP=137.97.6.147
LOCAL_HOST=172.16.7.209

# Postgres superuser — DB owner, used by Keycloak too (needs schema rights)
DB_USERNAME=cms_user
DB_PASSWORD=CHANGE_ME_STRONG_UNIQUE_DB_PASSWORD

# Low-privilege app user — used by Spring Boot backend only (Phase 2.10)
# Grants: CONNECT, USAGE, SELECT/INSERT/UPDATE/DELETE on all tables + sequences
BACKEND_DB_USERNAME=cms_app
BACKEND_DB_PASSWORD=CHANGE_ME_STRONG_UNIQUE_APP_PASSWORD

KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG_UNIQUE_KEYCLOAK_PASSWORD

# MinIO object storage — used for all file uploads (documents, photos)
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD inside the container are set from these.
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_STRONG_MINIO_SECRET

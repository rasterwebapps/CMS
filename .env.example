# Copy this file to /docker_data/.env on the deployment server.
# Set permissions: chmod 600 /docker_data/.env
#
# Fill in all values before running docker compose.
# Never commit the real .env file to git.

# ── Nexus registry ────────────────────────────────────────────────────────────
NEXUS_URL=http://192.168.1.x:8081
APP_VERSION=latest

# ── Server identity ───────────────────────────────────────────────────────────
# Used for Keycloak hostname, JWT issuer URL, and CORS origin.
DEPLOY_HOST=cms.nursing.sksh.ac.in
PUBLIC_IP=137.97.6.147
LOCAL_HOST=172.16.7.209

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL runs inside Docker. These credentials are used by both
# the CMS backend and Keycloak (same DB instance, same user).
DB_USERNAME=cms_user
DB_PASSWORD=CHANGE_ME_strong_password_here

# ── Keycloak admin ────────────────────────────────────────────────────────────
# Admin console password — must be different from DB_PASSWORD.
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_different_strong_password

# ── MinIO (object storage) ────────────────────────────────────────────────────
# Dev default endpoint is http://172.17.1.243:9000 (override if needed).
MINIO_ENDPOINT=http://172.17.1.243:9000
MINIO_ACCESS_KEY=CHANGE_ME_minio_user
MINIO_SECRET_KEY=CHANGE_ME_minio_password
MINIO_BUCKET=cms-documents

# ── Rate limiting ─────────────────────────────────────────────────────────────
limit_req_zone $binary_remote_addr zone=auth:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=api:10m  rate=30r/s;

# ── Dynamic port extraction from Host header ──────────────────────────────────
# Handles both dev.raster.in:212 and 172.17.1.243:8443 transparently.
map $http_host $forwarded_port {
    ~:(\d+)$  $1;
    default   443;
}

server {
    listen 80;
    server_tokens off;

    # Keycloak JS requires Web Crypto, which browsers expose only in secure
    # contexts. Always move production traffic to HTTPS.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_tokens off;
    client_max_body_size 10m;
    autoindex off;

    ssl_certificate     /etc/nginx/ssl/self.crt;
    ssl_certificate_key /etc/nginx/ssl/self.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root  /usr/share/nginx/html;
    index index.html;

    # ── Security headers ──────────────────────────────────────────────────────
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff"                              always;
    add_header X-Frame-Options           "SAMEORIGIN"                           always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin"      always;
    add_header Permissions-Policy        "geolocation=(), microphone=(), camera=()" always;

    # ── Block Keycloak Admin Console from public access ───────────────────────
    # Admin must only be reached via SSH tunnel on port 8180 directly.
    location /admin/ {
        return 403;
    }

    # ── Keycloak proxy ────────────────────────────────────────────────────────
    # X-Forwarded-Host is ALWAYS canonical (dev.raster.in:212) so JWTs always
    # carry the same issuer the Spring Boot backend trusts.
    #
    # sub_filter rewrites absolute Keycloak URLs in HTML responses so that
    # form actions and redirects point back to the origin the browser actually
    # used. For dev.raster.in:212 this is a no-op; for 172.17.1.243:8443 it
    # prevents the session-cookie/domain mismatch that causes HTTP 400 on
    # login form submit.
    location /realms/ {
        limit_req zone=auth burst=30 nodelay;
        proxy_pass http://${KEYCLOAK_UPSTREAM};
        proxy_set_header Host              ${KEYCLOAK_CANONICAL_HOST};
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  ${KEYCLOAK_CANONICAL_HOST};
        proxy_set_header X-Forwarded-Port  ${KEYCLOAK_CANONICAL_PORT};
        # Disable upstream compression so sub_filter can read the body
        proxy_set_header Accept-Encoding   "";
        # Rewrite canonical URLs back to the browser's actual origin
        sub_filter      'https://${KEYCLOAK_CANONICAL_HOST}' 'https://$http_host';
        sub_filter_once off;
        sub_filter_types text/html application/json;
        proxy_buffer_size  128k;
        proxy_buffers      4 256k;
    }

    location /resources/ {
        limit_req zone=auth burst=30 nodelay;
        proxy_pass http://${KEYCLOAK_UPSTREAM};
        proxy_set_header Host              ${KEYCLOAK_CANONICAL_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port  ${KEYCLOAK_CANONICAL_PORT};
        proxy_set_header Accept-Encoding   "";
        sub_filter      'https://${KEYCLOAK_CANONICAL_HOST}' 'https://$http_host';
        sub_filter_once off;
        sub_filter_types text/html application/json;
    }

    # ── Spring Boot API proxy ─────────────────────────────────────────────────
    location /api/ {
        limit_req zone=api burst=60 nodelay;
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── env.js — never cache (content changes per deployment/server) ──────────
    location = /assets/env.js {
        add_header Cache-Control                "no-cache, no-store, must-revalidate"          always;
        add_header Pragma                       "no-cache"                                     always;
        add_header Strict-Transport-Security    "max-age=31536000; includeSubDomains"          always;
        add_header X-Content-Type-Options       "nosniff"                                      always;
        add_header X-Frame-Options              "SAMEORIGIN"                                   always;
        add_header Referrer-Policy              "strict-origin-when-cross-origin"              always;
        add_header Permissions-Policy           "geolocation=(), microphone=(), camera=()"     always;
        expires 0;
    }

    # ── Angular SPA ───────────────────────────────────────────────────────────
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control                "no-cache, no-store, must-revalidate"          always;
        add_header Pragma                       "no-cache"                                     always;
        add_header Strict-Transport-Security    "max-age=31536000; includeSubDomains"          always;
        add_header X-Content-Type-Options       "nosniff"                                      always;
        add_header X-Frame-Options              "SAMEORIGIN"                                   always;
        add_header Referrer-Policy              "strict-origin-when-cross-origin"              always;
        add_header Permissions-Policy           "geolocation=(), microphone=(), camera=()"     always;
        add_header Content-Security-Policy      "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none';" always;
    }
}

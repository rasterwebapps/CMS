# =============================================================================
#  deploy-209.env.example  —  Template for deploy-209.env
#
#  Copy this file:
#    cp scripts/deploy-209.env.example scripts/deploy-209.env
#
#  Then fill in real values in deploy-209.env (it is gitignored).
#
#  Usage:
#    source scripts/deploy-209.env && ./scripts/deploy-209.sh
#    source scripts/deploy-209.env && ./scripts/deploy-209.sh frontend
#    source scripts/deploy-209.env && ./scripts/deploy-209.sh backend
#
#  Phase status guide:
#    Before Phase 4.2  → set DEPLOY209_PASS (SSH uses password)
#    After  Phase 4.2  → comment out DEPLOY209_PASS (SSH uses your key)
#    After  Phase 0.2  → update DB_PASS and KC_PASS with rotated values
# =============================================================================

# ── SSH password ─────────────────────────────────────────────────────────────
# Only needed before Phase 4.2 (while SSH password auth is still active).
# Comment out / remove after Phase 4.2 is done.
# export DEPLOY209_PASS='CHANGE_ME_SSH_PASSWORD'

# ── Sudo password ─────────────────────────────────────────────────────────────
# sksadmin's login password — used only for sudo -S (not for SSH login).
# Required after Phase 4.2 (key-based SSH) + Phase 4.5 (no NOPASSWD sudo).
export DEPLOY209_SUDO_PASS='CHANGE_ME_SUDO_PASSWORD'

# ── Database password (cms_user — Postgres owner / Keycloak) ─────────────────
# REQUIRED — no default in the script. Use a strong unique password.
export DEPLOY209_DB_PASS='CHANGE_ME_DB_PASSWORD'

# ── Backend app user password (cms_app — Spring Boot only, Phase 2.10) ────────
# REQUIRED — password set for cms_app during security hardening.
export DEPLOY209_BACKEND_DB_PASS='CHANGE_ME_APP_DB_PASSWORD'

# ── Keycloak admin password ───────────────────────────────────────────────────
# REQUIRED — no default in the script. Use a strong unique password.
export DEPLOY209_KC_PASS='CHANGE_ME_KC_PASSWORD'

# ── Optional overrides (safe defaults are built into the script) ──────────────
# Uncomment and change only if the server layout has changed.
# export DEPLOY209_SERVER='172.16.7.209'
# export DEPLOY209_USER='sksadmin'
# export DEPLOY209_PUBLIC_HOST='cms.nursing.sksh.ac.in'
# export DEPLOY209_PUBLIC_IP='137.97.6.147'
# export DEPLOY209_LOCAL_HOST='172.16.7.209'
# export DEPLOY209_DIR='/docker_data/skscms209'

# ── TLS certificate paths ─────────────────────────────────────────────────────
# Uncomment and update if your cert files have moved from the default location.
# export DEPLOY209_TLS_CERT_FILE='/path/to/Certificate.txt'
# export DEPLOY209_TLS_INTERMEDIATE_FILE='/path/to/Intermediate Certificate.txt'
# export DEPLOY209_TLS_PRIVATE_KEY_FILE='/path/to/RSA Private Key.txt'

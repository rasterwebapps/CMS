# Copy to .env and fill in real values. Never commit the real .env (already gitignored).

# Target environment — the local regression-gate script points this at 243 after deploy.
E2E_BASE_URL=https://dev.raster.in:212

# 243 is behind a self-signed / internal cert chain in some setups — flip to false once real certs are trusted.
E2E_IGNORE_HTTPS_ERRORS=true

# One Keycloak test account per role this suite drives. Leave a value blank to skip
# specs that require that role (they report as skipped, not failed).
E2E_ADMIN_USER=
E2E_ADMIN_PASS=

E2E_COLLEGE_ADMIN_USER=
E2E_COLLEGE_ADMIN_PASS=

E2E_CASHIER_USER=
E2E_CASHIER_PASS=

E2E_FACULTY_USER=
E2E_FACULTY_PASS=

E2E_STUDENT_USER=
E2E_STUDENT_PASS=

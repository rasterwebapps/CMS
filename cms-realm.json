      "webOrigins": ["http://localhost:4200", "http://localhost:4300"],
      "protocol": "openid-connect"
    },
    {
      "clientId": "cms-backend",
      "bearerOnly": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "devadmin",
